<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="PostgreDS" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/PostgreDS</jta-data-source>
        <class>jpchs.entity.StudyGroup</class>
        <class>jpchs.entity.Person</class>
        <class>jpchs.entity.Coordinates</class>
        <class>jpchs.entity.Location</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>